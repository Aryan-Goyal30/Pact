# SQLite database file used for local development.
DATABASE_URL="file:./dev.db"

# Anthropic API key, used by the Buyer/Merchant Agents to phrase
# deterministic negotiation results as natural language, when
# LLM_PROVIDER=claude (or unset — claude is the default).
ANTHROPIC_API_KEY=

# Google Gemini API key, used by the Buyer/Merchant Agents when
# LLM_PROVIDER=gemini.
GEMINI_API_KEY=

# Which LLM provider the agents use: "claude" (default) or "gemini".
LLM_PROVIDER=

# Neither key is required to run the app or the negotiation demo: if the
# selected provider's key is missing, agents fall back to a
# deterministic, non-LLM message instead of failing the negotiation —
# every price/quantity/delivery/outcome is identical either way, only
# the phrasing differs. POST /api/negotiate (the older single-shot
# endpoint) is the one exception — it returns a clear 503 instead of
# falling back, so it can be used as a direct LLM connectivity check.

# --- Used starting in a later phase, not required yet ---

# Razorpay test-mode credentials, used by the payment flow.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
