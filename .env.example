# SQLite database file used for local development.
DATABASE_URL="file:./dev.db"

# Anthropic API key, used by the Merchant Agent to phrase deterministic
# negotiation results as natural language (POST /api/negotiate). Required
# starting Phase 4 — without it, that endpoint returns a clear 503 error
# instead of crashing.
ANTHROPIC_API_KEY=

# --- Used starting in a later phase, not required yet ---

# Razorpay test-mode credentials, used by the payment flow.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
