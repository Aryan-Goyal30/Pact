# SQLite database file used for local development.
DATABASE_URL="file:./dev.db"

# Anthropic API key, used by the Buyer/Merchant Agents to phrase
# deterministic negotiation results as natural language, when
# LLM_PROVIDER=claude (or unset — claude is the default).
ANTHROPIC_API_KEY=

# Google Gemini API key, used by the Buyer/Merchant Agents when
# LLM_PROVIDER=gemini.
GEMINI_API_KEY=

# Which LLM provider the agents use: "claude" (default) or "gemini".
LLM_PROVIDER=

# Neither key is required to run the app or the negotiation demo: if the
# selected provider's key is missing, agents fall back to a
# deterministic, non-LLM message instead of failing the negotiation —
# every price/quantity/delivery/outcome is identical either way, only
# the phrasing differs. POST /api/negotiate (the older single-shot
# endpoint) is the one exception — it returns a clear 503 instead of
# falling back, so it can be used as a direct LLM connectivity check.

# --- Milestone 13: Razorpay payment + recovery ---

# Razorpay test-mode credentials (from the Razorpay Dashboard's API Keys
# section). RAZORPAY_KEY_ID is also sent to the browser to open Razorpay
# Checkout — this is Razorpay's own public identifier and is safe to
# expose. RAZORPAY_KEY_SECRET must NEVER reach the browser; it is read
# only inside src/lib/payment/razorpayClient.ts, the one file that owns
# the Razorpay SDK and computes checkout-signature HMACs.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay webhook secret (from the Dashboard's Webhooks section, set
# per configured webhook endpoint) — a DIFFERENT secret from
# RAZORPAY_KEY_SECRET, used only to verify POST /api/payments/webhook
# requests actually came from Razorpay. Also never sent to the browser.
RAZORPAY_WEBHOOK_SECRET=

# Which payment provider PACT uses: "razorpay" (default) or "mock" — the
# mock provider is a fully deterministic, network-free stand-in used for
# demos/tests (see src/lib/payment/mockRazorpayAdapter.ts); it can never
# be selected when NODE_ENV=production, regardless of this value. Payment
# still runs its real state machine and DB writes in mock mode — only the
# external Razorpay interaction itself is faked.
PAYMENT_PROVIDER=
